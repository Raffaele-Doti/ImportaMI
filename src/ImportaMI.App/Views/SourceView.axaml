<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ImportaMI.App.ViewModels"
             xmlns:res="using:ImportaMI.App.Resources"
             x:Class="ImportaMI.App.Views.SourceView"
             x:DataType="vm:SourceViewModel">

    <DockPanel>
        <!-- Intestazione -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,18,24,14">
            <StackPanel Spacing="4">
                <TextBlock Classes="title" Text="{x:Static res:Strings.SourceTitle}" />
                <TextBlock Classes="muted" Text="{x:Static res:Strings.SourceSubtitle}" />
            </StackPanel>
        </Border>

        <!-- Barra delle azioni -->
        <Border DockPanel.Dock="Bottom" Classes="actionbar">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" IsVisible="{Binding IsScanning}">
                    <ProgressBar IsIndeterminate="True" Width="120" />
                    <TextBlock Classes="muted" Text="{Binding ProgressText}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelScanCommand}" IsVisible="{Binding IsScanning}" />
                    <Button Content="{x:Static res:Strings.BrowseFolder}" Command="{Binding BrowseCommand}" />
                    <Button Classes="accent" Content="{x:Static res:Strings.Scan}" Command="{Binding ScanCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Padding="24,20">
            <StackPanel Spacing="12" MaxWidth="820" HorizontalAlignment="Left">
                <!-- Esito della scansione: niente foto, sorgente scollegata, errore -->
                <Border Classes="card" IsVisible="{Binding HasMessage}"
                        BorderBrush="{StaticResource WarnBrush}"
                        Classes.error="{Binding MessageIsError}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding MessageTitle}" FontWeight="SemiBold" />
                        <TextBlock Classes="muted" Text="{Binding MessageDetail}" TextWrapping="Wrap"
                                   IsVisible="{Binding MessageDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Border>

                <TextBlock Classes="muted" Text="{x:Static res:Strings.SourceNoDrives}" TextWrapping="Wrap" IsVisible="{Binding HasNoSources}" />

                <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" Background="Transparent"
                         IsEnabled="{Binding !IsScanning}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SourceItemViewModel">
                            <Grid ColumnDefinitions="44,*,Auto" Margin="2,6">
                                <Border Width="40" Height="40" CornerRadius="9" Background="{StaticResource RaisedBrush}">
                                    <Panel>
                                        <!-- scheda SD, disco, cartella -->
                                        <PathIcon Width="20" Height="20" IsVisible="{Binding IsRemovable}"
                                                  Data="M7,2 H15 L19,6 V20 A2,2 0 0 1 17,22 H7 A2,2 0 0 1 5,20 V4 A2,2 0 0 1 7,2 Z M9,6 V9 H10.5 V6 Z M12,6 V9 H13.5 V6 Z M15,7 V9 H16.5 V7 Z" />
                                        <PathIcon Width="20" Height="20" IsVisible="{Binding IsDrive}"
                                                  Data="M4,6 H20 A2,2 0 0 1 22,8 V16 A2,2 0 0 1 20,18 H4 A2,2 0 0 1 2,16 V8 A2,2 0 0 1 4,6 Z M6,12 A1,1 0 1 0 6.01,12 Z M10,11.25 H18 V12.75 H10 Z" />
                                        <PathIcon Width="20" Height="20" IsVisible="{Binding IsFolder}"
                                                  Data="M3,6 A2,2 0 0 1 5,4 H9 L11,6 H19 A2,2 0 0 1 21,8 V18 A2,2 0 0 1 19,20 H5 A2,2 0 0 1 3,18 Z" />
                                    </Panel>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0" Spacing="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="14" />
                                        <Border Classes="chip" Background="{StaticResource AccentSoftBrush}" IsVisible="{Binding IsNew}">
                                            <TextBlock Text="{x:Static res:Strings.SourceNew}" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Classes="muted" Text="{Binding Description}" FontSize="12" />
                                    <ProgressBar Value="{Binding UsedPercent}" Maximum="100" Height="4" MinHeight="4" Width="240"
                                                 HorizontalAlignment="Left" IsVisible="{Binding HasSpace}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Classes="mono muted" Text="{Binding SpaceText}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>

    <UserControl.Styles>
        <Style Selector="Border.card.error">
            <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
        </Style>

        <!-- Ogni sorgente è una scheda; quella scelta ha bordo ambra e fondo tenue, non un ambra pieno. -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
    </UserControl.Styles>
</UserControl>
